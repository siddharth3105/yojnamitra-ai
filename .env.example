# AWS Credentials (renamed to avoid Amplify reserved prefix)
# Get these from AWS IAM Console after creating an IAM user
BEDROCK_ACCESS_KEY_ID=your_access_key_id_here
BEDROCK_SECRET_ACCESS_KEY=your_secret_access_key_here

# AWS Region
# Choose the region where you enabled Bedrock model access
# Common options: ap-south-1 (Mumbai), us-east-1 (N. Virginia), us-west-2 (Oregon)
BEDROCK_REGION=ap-south-1

# Bedrock Model ID
# Get the exact model ID from AWS Bedrock Model Catalog
# For Qwen3 235B: qwen.qwen3-235b-a22b-2507-v1:0
# For Claude 3.5 Sonnet: anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_MODEL_ID=qwen.qwen3-235b-a22b-2507-v1:0

# Instructions:
# 1. Copy this file to .env
# 2. Replace the placeholder values with your actual AWS credentials
# 3. Never commit .env file to Git (it's in .gitignore)
# 4. For AWS Amplify deployment, use these exact variable names in Amplify Console
